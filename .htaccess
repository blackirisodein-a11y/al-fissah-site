# Hébergement Apache (OVH, o2switch, Hostinger, LWS, IONOS…)

# Page d'erreur personnalisée (ses liens et images sont en chemins absolus : elle
# s'affiche correctement à n'importe quelle profondeur, p. ex. /fr/login/x)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Adresse unique : https://al-fissah.com (21/11/2026 — la vitrine quitte al-fissah.fr,
  #    l'ancien site disparaît). www.al-fissah.com, al-fissah.fr et www.al-fissah.fr →
  #    https://al-fissah.com en un seul saut, chemin conservé (les règles de l'étape 4
  #    s'appliquent ensuite). L'adresse de test al-fissah.blackirys.com n'est pas concernée.
  RewriteCond %{HTTP_HOST} ^(www\.al-fissah\.com|(www\.)?al-fissah\.fr)$ [NC]
  RewriteRule ^ https://al-fissah.com%{REQUEST_URI} [L,R=301]

  # 2. Forcer HTTPS — si vous voyez une erreur de boucle de redirection,
  #    mettez un # devant les deux lignes ci-dessous jusqu'à l'activation du certificat SSL.
  #    Sauf /.well-known/ : la vérification du certificat Let's Encrypt passe en http (21/11/2026).
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. Dossiers de langue sans barre finale (/en → /en/) : directement en https,
  #    sans passer par l'adresse http qu'Apache fabriquerait seul.
  RewriteRule ^(ar|en|es|de|ru)$ https://%{HTTP_HOST}/$1/ [L,R=301]

  # 4. Anciennes adresses de l'ancien site (al-fissah.com) → plateforme des comptes.
  #    La plateforme existe en fr / en / ar / ru ; es et de vont vers l'anglais.
  RewriteRule ^(fr|en|ar|ru)/(login|connexion|signin)/?$ https://etudiant.al-fissah.com/$1/login [L,R=301]
  RewriteRule ^(es|de)/(login|connexion|signin)/?$ https://etudiant.al-fissah.com/en/login [L,R=301]
  RewriteRule ^(fr|en|ar|ru)/(register|signup|commander)(/.*)?$ https://etudiant.al-fissah.com/$1/inscription [L,R=301]
  RewriteRule ^(es|de)/(register|signup|commander)(/.*)?$ https://etudiant.al-fissah.com/en/inscription [L,R=301]
  RewriteRule ^login/?$ https://etudiant.al-fissah.com/fr/login [L,R=301]
  RewriteRule ^register/?$ https://etudiant.al-fissah.com/fr/inscription [L,R=301]
  #    Mot de passe oublié de l'ancien site (/fr/password/reset…) → page de connexion
  #    (le lien « Mot de passe oublié ? » s'y trouve).
  RewriteRule ^(fr|en|ar|ru)/password(/.*)?$ https://etudiant.al-fissah.com/$1/login [L,R=301]
  RewriteRule ^(es|de)/password(/.*)?$ https://etudiant.al-fissah.com/en/login [L,R=301]
  RewriteRule ^password(/.*)?$ https://etudiant.al-fissah.com/fr/login [L,R=301]
  #    Anciennes pages de présentation (relevées sur l'ancien site le 20/11/2026, fr / en / ar) :
  #    le français est à la racine, les autres langues dans leur dossier.
  RewriteRule ^fr/(a-propos|contact|tarifs)/?$ https://%{HTTP_HOST}/$1.html [L,R=301]
  RewriteRule ^(en|ar|ru|es|de)/(a-propos|contact|tarifs)/?$ https://%{HTTP_HOST}/$1/$2.html [L,R=301]
  RewriteRule ^fr/pages/faq/?$ https://%{HTTP_HOST}/faq.html [L,R=301]
  RewriteRule ^(en|ar|ru|es|de)/pages/faq/?$ https://%{HTTP_HOST}/$1/faq.html [L,R=301]
  RewriteRule ^fr/pages/le-reglement-interieur/?$ https://%{HTTP_HOST}/reglement.html [L,R=301]
  RewriteRule ^(en|ar|ru|es|de)/pages/le-reglement-interieur/?$ https://%{HTTP_HOST}/$1/reglement.html [L,R=301]
  RewriteRule ^fr/programmes(/.*)?$ https://%{HTTP_HOST}/programmes.html [L,R=301]
  RewriteRule ^(en|ar|ru|es|de)/programmes(/.*)?$ https://%{HTTP_HOST}/$1/programmes.html [L,R=301]
  RewriteRule ^(en|ar|ru|es|de)/testimonials/?$ https://%{HTTP_HOST}/$1/temoignages.html [L,R=301]
  RewriteRule ^fr/?$ https://%{HTTP_HOST}/ [L,R=301]
  RewriteRule ^fr/testimonials/?$ https://%{HTTP_HOST}/temoignages.html [L,R=301]
</IfModule>

# En-têtes de sécurité (mod_headers est actif chez LWS : le cache ci-dessous fonctionne)
<IfModule mod_headers.c>
  # HTTPS obligatoire pendant un an pour ce domaine (sans les sous-domaines : la plateforme
  # etudiant / enseignant / gestion est hébergée ailleurs et gère ses propres en-têtes)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Encodage
AddDefaultCharset UTF-8
AddType font/woff2 .woff2
AddType image/webp .webp

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# Mise en cache des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  # Polices et images : leur nom ne change pas quand elles changent → cache long, sans revalidation
  <FilesMatch "\.(woff2|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages : une version compressée et une non compressée peuvent coexister dans les caches intermédiaires
  <FilesMatch "\.html$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# Sécurité : ne pas servir les fichiers de travail
<FilesMatch "\.(py|md|toml|bat|command|conf)$">
  Require all denied
</FilesMatch>
